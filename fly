#!/usr/bin/env bash

KERNEL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEVICE="courbet"
DEVICE_NAME="Xiaomi Mi 11 Lite"
KNAME="Mishiranu"
VAR="AOSP"
ROT="KSU"

ANYKERNEL_REPO="https://github.com/Szetian/AnyKernel3.git"
ANYKERNEL_BRANCH="master"

OUT="$KERNEL_DIR/out"
KERNEL="$OUT/arch/arm64/boot/Image.gz"
DTBO="$OUT/arch/arm64/boot/dtbo.img"
DTB="$OUT/arch/arm64/boot/dtb.img"
BUILD_LOG="$KERNEL_DIR/build.log"
ZIPNAME="${KNAME}-${VAR}-${ROT}.zip"

: "${TG_TOKEN:?TG_TOKEN belum di-set}"
: "${TG_CHAT_ID:?TG_CHAT_ID belum di-set}"

export ARCH=arm64
export KBUILD_BUILD_USER="Szè"
export KBUILD_BUILD_HOST="Haotian-#09"
export KBUILD_COMPILER_STRING="Neutron Clang 12.0"

SECONDS=0
DOCKER_OS="$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME")"
DATE="$(TZ=Asia/Jakarta date '+%d %B %Y, %H:%M WIB')"
COMPILER="$(clang --version 2>/dev/null | head -n1)"


esc() {
    sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<< "$1"
}

tg_msg() {
    local response

    if ! response="$(curl -sS \
        --data-urlencode "chat_id=$TG_CHAT_ID" \
        --data-urlencode "parse_mode=HTML" \
        --data-urlencode "disable_web_page_preview=true" \
        --data-urlencode "text=$1" \
        "https://api.telegram.org/bot${TG_TOKEN}/sendMessage")"; then
        echo "[Telegram] Gagal mengirim pesan (curl error)."
        return 1
    fi

    if grep -q '"ok"[[:space:]]*:[[:space:]]*true' <<< "$response"; then
        return 0
    fi

    echo "[Telegram] Pesan ditolak: $response"
    return 1
}



tg_send_file() {
    local file="$1"
    local caption="$2"
    local response
    local filename

    # Resolve absolute path
    file="$(realpath -e -- "$file")" || {
        echo "[Telegram] File tidak ditemukan!"
        return 1
    }

    if [[ ! -r "$file" ]]; then
        echo "[Telegram] Cannot Read: $file"
        return 1
    fi

    filename="$(basename "$file")"

    # Telegram Bot API limit
    if (( $(stat -c%s "$file") > 50 * 1024 * 1024 )); then
        echo "[Telegram] File melebihi batas 50 MB."
        return 1
    fi

    echo "[Telegram] Uploading: $filename"
    echo "[Telegram] Path: $file"

    # Pass the file path quoted so paths containing spaces work, and keep
    # the caption out of the multipart request: mixing a long, multi-line
    # caption into the same request can make Telegram reject the upload.
    response=$(curl -sS \
        -F "chat_id=${TG_CHAT_ID}" \
        -F "document=@\"${file}\";filename=${filename}" \
        "https://api.telegram.org/bot${TG_TOKEN}/sendDocument") || {
            echo "[Telegram] CURL upload failed."
            return 1
        }

    if grep -q '"ok"[[:space:]]*:[[:space:]]*true' <<< "$response"; then
        echo "[Telegram] Upload successful!"
    else
        echo "[Telegram] Telegram API Error:"
        echo "$response"
        return 1
    fi

    # Deliver the caption as a separate message after the file is up.
    tg_msg "$caption" || echo "[Telegram] Caption message gagal, file sudah terkirim."
    return 0
}



duration() {
    echo "$((SECONDS / 60)) minutes $((SECONDS % 60)) seconds"
}

fail() {
    local reason="$1"
    local log_file="${2:-}"

    local message="<b>Build Failed!</b>

<b>Device:</b> $DEVICE_NAME ($DEVICE)
<b>Error:</b> $(esc "$reason")
<b>Build took:</b> $(duration)"

    if [[ -n "$log_file" && -f "$log_file" ]]; then
        tg_send_file "$log_file" "$message" || tg_msg "$message"
    else
        tg_msg "$message"
    fi

    exit 1
}


tg_msg "<b>Kernel Build Triggered</b>

<b>Docker OS:</b> $(esc "$DOCKER_OS")
<b>Date:</b> $DATE
<b>Device:</b> $DEVICE_NAME
<b>Codename:</b> $DEVICE
<b>Kernel Version:</b> $KVER
<b>Root:</b> $ROT
<b>Compiler:</b> $(esc "$COMPILER")" || echo "[Telegram] Notifikasi awal gagal."

cd "$KERNEL_DIR" || exit 1


if [[ "${1:-}" == "-c" || "${1:-}" == "--clean" ]]; then
    echo "Cleaning output..."
    rm -rf "$OUT"
fi

mkdir -p "$OUT"
: > "$BUILD_LOG"


echo "Loading defconfig..."

make O="$OUT" \
    ARCH=arm64 \
    CC=clang \
    CROSS_COMPILE=aarch64-linux-gnu- \
    vendor/courbet_defconfig 2>&1 | tee -a "$BUILD_LOG"

BUILD_STATUS=${PIPESTATUS[0]}
if (( BUILD_STATUS != 0 )); then
    fail "Defconfig failed" "$BUILD_LOG"
fi


echo "Compiling kernel..."

make -j"$(nproc --all)" \
    O="$OUT" \
    ARCH=arm64 \
    LLVM=1 \
    LLVM_IAS=1 \
    CC=clang \
    CLANG_TRIPLE="${CLANG_PATH}/aarch64-linux-gnu-" \
    CROSS_COMPILE=aarch64-linux-gnu- \
    CROSS_COMPILE_ARM32=aarch64-linux-gnu- \
    2>&1 | tee -a "$BUILD_LOG"

BUILD_STATUS=${PIPESTATUS[0]}
if (( BUILD_STATUS != 0 )) || [[ ! -f "$KERNEL" ]]; then
    fail "Kernel compilation failed" "$BUILD_LOG"
fi


echo "Packaging AnyKernel3..."

AK_DIR="$KERNEL_DIR/AnyKernel3"
rm -rf "$AK_DIR"

git clone -q -b "$ANYKERNEL_BRANCH" "$ANYKERNEL_REPO" "$AK_DIR" \
    || fail "AnyKernel3 clone failed"

sed -i 's/device\.name1=.*/device.name1=courbet/' "$AK_DIR/anykernel.sh"
sed -i 's/device\.name2=.*/device.name2=courbetin/' "$AK_DIR/anykernel.sh"

cp "$KERNEL" "$AK_DIR/"
[[ -f "$DTBO" ]] && cp "$DTBO" "$AK_DIR/"
[[ -f "$DTB" ]] && cp "$DTB" "$AK_DIR/"

rm -f "$KERNEL_DIR/$ZIPNAME"
(
    cd "$AK_DIR" &&
    zip -r9 "$KERNEL_DIR/$ZIPNAME" . -x '*.git*' '*.github*' >/dev/null
)
ZIP_STATUS=$?

rm -rf "$AK_DIR"

if (( ZIP_STATUS != 0 )) || [[ ! -f "$KERNEL_DIR/$ZIPNAME" ]]; then
    fail "ZIP creation failed"
fi


SIZE="$(du -h "$KERNEL_DIR/$ZIPNAME" | cut -f1)"
MD5="$(md5sum "$KERNEL_DIR/$ZIPNAME" | cut -d' ' -f1)"

MESSAGE="<b>Build Finished!</b>

<b>Device:</b> $DEVICE_NAME ($DEVICE)
<b>Variant:</b> $ROT
<b>Package:</b> Flashable AnyKernel3 ZIP
<b>Size:</b> $SIZE
<b>Build took:</b> $(duration)
<b>MD5:</b> <code>$MD5</code>"

if ! tg_send_file "$KERNEL_DIR/$ZIPNAME" "$MESSAGE"; then
    tg_msg "<b>Build complete</b>

<b>Package:</b> $ZIPNAME
<b>Size:</b> $SIZE
<b>MD5:</b> <code>$MD5</code>"
    exit 1
fi

echo
echo "Build complete: $ZIPNAME ($(duration))"
